# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Trained weights. Only the published experiment checkpoint is tracked, so that cloning gives a
# usable model. Change the filename below when you publish a newer one.
checkpoints/*
!checkpoints/experiment/
checkpoints/experiment/*
!checkpoints/experiment/ddg/
checkpoints/experiment/ddg/*
!checkpoints/experiment/ddg/checkpoint_epoch5.pt

# Evaluation runs are a measurement, not part of the repository: one model per training split and
# initial state, trained by --train_for_evaluation. Anyone measuring performance trains their own.
checkpoints/evaluation/

# The per-split PKAD tables do ship. Building them needs MMseqs2, so without them a clone could
# not run --train_for_evaluation without WSL; they are a few hundred kilobytes in total.
data/Evaluation splits/*
!data/Evaluation splits/*_pkad.csv

# Run output. The predictions ship, so the published results can be checked row by row.
# The per-row detail files do not: there is one per prediction, tens of thousands of them and
# several gigabytes in total. Five are kept so that --plot_graph works on a fresh clone
# without training anything first: two reproduce Figure 1, two more show a clear titration, and
# one comes from the whole-protein scan so that the experiment mode can be tried too.
results/evaluation/*/details/*
results/experiment/*/details/*
!results/evaluation/training_split_9_initial_state_1/details/MSDKIIHLTD_D27A_pH7_T298.15K.pt
!results/evaluation/training_split_4_initial_state_1/details/MKALIVLGLV_V128F.pt
!results/evaluation/training_split_4_initial_state_1/details/MKALIVLGLV_C95A.pt
!results/evaluation/training_split_5_initial_state_1/details/MMKMEGIALK_H65A.pt
!results/experiment/2026-11-07_19-50-31/details/tr_Q308M6_Q308M6_HUMAN_E671W.pt


# FireProtDB's terms of use forbid transferring the output of their service to third parties,
# so the raw download is not redistributed here. PREPARE.md says where to get it.
data/Source data/

# Data that is downloaded or regenerated by --prepare, not stored here. The embedding caches are
# rebuilt from the sequences by ESM-2 on first use.
# See src/data_processing/CURATION_README.md for where each source comes from.
data/Saved embeddings/
data/pKa Embeddings/

# The full Swiss-Prot release is 275 MB, over GitHub's file limit. The subset holding just the
# entries the bundled FireProtDB file needs ships instead, so --prepare runs on a fresh clone.
data/Uniprot to sequence/*
!data/Uniprot to sequence/uniprot_sprot_subset.fasta

# The curated dataset and the split categorisation table ship, so the model can be retrained and
# the same splits reproduced without rerunning --prepare (which needs MMseqs2 and so WSL on
# Windows). The split folders themselves are rebuilt from the categorisation table on demand, and
# the timestamped audit logs stay local (tens of MB of near-duplicates).
data/Curated data/*
!data/Curated data/curated_data.csv
!data/Curated data/split_categorisation.csv

# Experiment inputs are the user's own; the example FASTA ships as a template.
data/Experiments/*
!data/Experiments/wt_sequences.fasta

# Large local downloads and databases
Miniconda3-*.sh
*.mdb
*.log

